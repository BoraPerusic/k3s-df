# Security
JWT_ISSUER_HOST=placeholder-issuer.com
JWT_ISSUER_JWK_SET_PATH=.well-known

# AI Providers
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_ENDPOINT=https://oai-dolphin-1.openai.azure.com/
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002

OLLAMA_HOST=localhost
OLLAMA_PORT=11434
OLLAMA_MODEL=llama3

ANTHROPIC_MODEL=claude-3-opus-20240229

GEMINI_MODEL=gemini-pro

# Async
NATS_SERVER_URL=nats://localhost:4222

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:8089
OTEL_PROMETHEUS_ENABLED=false
OTEL_TRACING_SAMPLING_PROBABILITY=1.0
OTEL_METRICS_EXPORT_OTLP_ENABLED=false
OTEL_PROMETHEUS_METRICS_EXPORT_ENABLED=false

# PostgreSQL
POSTGRESQL_HOST=data-postgres.data.svc.cluster.local
POSTGRESQL_PORT=7432

# LLM Gateway
LLM_GTW_SERVER_PORT=7101
LLM_GTW_SECURITY_ENABLED=false

LLM_GTW_DATABASE=llm_gateway
LLM_GTW_DB_USER=llm_gtw
LLM_GTW_STORAGE_TYPE=postgres

# ESO API
ESO_API_SERVER_PORT=7102
ESO_API_SECURITY_ENABLED=false

ESO_API_DATABASE=eso_mock
ESO_API_DB_USER=eso_mock
ESO_API_STORAGE_TYPE=postgres